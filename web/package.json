{
  "name": "roofiq-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "npm run build && npx --yes wrangler@4 dev",
    "typecheck": "tsc -b --noEmit",
    "deploy": "npm run build && npx --yes wrangler@4 deploy",
    "cf:check": "npm run build && npx --yes wrangler@4 deploy --dry-run",
    "start": "node server.mjs"
  },
  "dependencies": {
    "@supabase/supabase-js": "^2.45.4",
    "maplibre-gl": "^6.9.0",
    "pmtiles": "^4.5.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-router-dom": "^7.18.3"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.0.0",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^5.2.0",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.2",
    "vite": "^7.3.6"
  },
  "engines": {
    "node": ">=22"
  }
}
